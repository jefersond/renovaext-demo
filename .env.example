# =============================================================================
# RENOVAEXT MVP — VARIÁVEIS DE AMBIENTE (ISOLADO DA ZUNO E ZANOTELLI OS)
# Copie para .env.local quando desejar conectar a uma instância remota Supabase.
# Sem estas variáveis, o sistema opera automaticamente em Modo Homologação Local
# com isolamento multi-tenant completo (RLS local por company_id).
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=homologation
VITE_PAYMENT_BILLING_ENABLED=false
VITE_EXTERNAL_DISPATCH_ENABLED=false
